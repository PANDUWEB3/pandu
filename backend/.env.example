# Supabase workspace and SIWE wallet-link API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server/worker only: Supabase secret service key. NEVER expose to frontend.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME_SERVER_ONLY
# Legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# Blockchain configuration
PANDU_CHAIN=arbitrum-sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Kontrak v2 PANDUQualityRegistry
PANDU_REGISTRY_ADDRESS=SET_AFTER_SEPOLIA_DEPLOY
ADMIN_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_PRIVATE_KEY=SET_LOCALLY_ONLY
ISSUER_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata IPFS (JWT hanya di server, frontend mengunggah ciphertext melalui relayer)
PINATA_JWT=REPLACE_WITH_PINATA_JWT_SERVER_ONLY

# Keamanan token publik (minimal 32 byte hex/random)
PUBLIC_TOKEN_SECRET=GENERATE_RANDOM_32_BYTES_AND_KEEP_STABLE

# Server host & port
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Safety flags mainnet (default: false)
ENABLE_MAINNET_ANCHOR=false
ENABLE_MAINNET_DEPLOYMENT=false
MAINNET_DEPLOY_CONFIRMATION=
